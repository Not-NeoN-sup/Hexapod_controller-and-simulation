<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hexapod">
  <xacro:include filename="$(find hexapod_ws)/description/hexapod.gazebo"/>
  
  <xacro:property name="name_prefix" value=""/>
  <xacro:property name="joint_lower_limit" value="-1.57"/>
  <xacro:property name="joint_upper_limit" value="1.57"/>
  <xacro:property name="base_radius" value="0.18"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="hip_length" value="0.05"/>
  <xacro:property name="femur_length" value="0.12"/>
  <xacro:property name="tibia_length" value="0.18"/>
  <xacro:property name="leg_radius" value="0.01"/>
  
  <link name="base_footprint"/>
  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02077" ixy="0.0" ixz="0.0" iyy="0.02077" iyz="0.0" izz="0.0405"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
  </link>
  
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="2.08e-07" ixy="0" ixz="0" iyy="2.08e-07" iyz="0" izz="3.33e-07"/>
    </inertial>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 ${base_height+0.02}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 ${base_height+0.05}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- LEG MACRO -->
  <xacro:macro name="leg" params="leg_name hx hy hz hr hp hyaw">
    <!-- Hip Link -->
    <link name="${leg_name}_hip_link">
      <visual>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
        <material name="blue"><color rgba="0 0 1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="2.08e-05" ixy="0" ixz="0" iyy="2.08e-05" iyz="0" izz="5e-07"/>
      </inertial>
    </link>

    <joint name="${leg_name}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${leg_name}_hip_link"/>
      <origin xyz="${hx} ${hy} ${hz}" rpy="${hr} ${hp} ${hyaw}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="1.0"/>
    </joint>

    <!-- Femur Link -->
    <link name="${leg_name}_femur_link">
      <visual>
        <origin xyz="0 0 ${-femur_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${femur_length}"/></geometry>
        <material name="green"><color rgba="0 1 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${-femur_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${femur_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-femur_length/2}" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="1.8e-04" ixy="0" ixz="0" iyy="1.8e-04" iyz="0" izz="1.125e-06"/>
      </inertial>
    </link>

    <joint name="${leg_name}_femur_joint" type="revolute">
      <parent link="${leg_name}_hip_link"/>
      <child link="${leg_name}_femur_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="1.0"/>
    </joint>

    <!-- Tibia Link -->
    <link name="${leg_name}_tibia_link">
      <visual>
        <origin xyz="0 0 ${-tibia_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${tibia_length}"/></geometry>
        <material name="red"><color rgba="1 0 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${-tibia_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${tibia_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-tibia_length/2}" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="3.24e-04" ixy="0" ixz="0" iyy="3.24e-04" iyz="0" izz="7.2e-07"/>
      </inertial>
    </link>

    <joint name="${leg_name}_tibia_joint" type="revolute">
      <parent link="${leg_name}_femur_link"/>
      <child link="${leg_name}_tibia_link"/>
      <origin xyz="0 0 ${-femur_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="1.0"/>
    </joint>
  </xacro:macro>

  <!-- CREATE 6 LEGS -->
  <xacro:leg leg_name="leg_1" hx="${base_radius*0.866}" hy="${base_radius*0.5}" hz="${base_height}" hr="0" hp="0" hyaw="0.524"/>
  <xacro:leg leg_name="leg_2" hx="0" hy="${base_radius}" hz="${base_height}" hr="0" hp="0" hyaw="1.571"/>
  <xacro:leg leg_name="leg_3" hx="${-base_radius*0.866}" hy="${base_radius*0.5}" hz="${base_height}" hr="0" hp="0" hyaw="2.618"/>
  <xacro:leg leg_name="leg_4" hx="${-base_radius*0.866}" hy="${-base_radius*0.5}" hz="${base_height}" hr="0" hp="0" hyaw="3.665"/>
  <xacro:leg leg_name="leg_5" hx="0" hy="${-base_radius}" hz="${base_height}" hr="0" hp="0" hyaw="4.712"/>
  <xacro:leg leg_name="leg_6" hx="${base_radius*0.866}" hy="${-base_radius*0.5}" hz="${base_height}" hr="0" hp="0" hyaw="5.759"/>

  <!-- ROS2 CONTROL - GAZEBO HARDWARE INTERFACE -->
  <ros2_control name="HexapodSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <!-- DEFINE ALL JOINTS -->
    <xacro:macro name="joint_interface" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position">
          <param name="min">${joint_lower_limit}</param>
          <param name="max">${joint_upper_limit}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:joint_interface joint_name="leg_1_hip_joint"/>
    <xacro:joint_interface joint_name="leg_1_femur_joint"/>
    <xacro:joint_interface joint_name="leg_1_tibia_joint"/>
    <xacro:joint_interface joint_name="leg_2_hip_joint"/>
    <xacro:joint_interface joint_name="leg_2_femur_joint"/>
    <xacro:joint_interface joint_name="leg_2_tibia_joint"/>
    <xacro:joint_interface joint_name="leg_3_hip_joint"/>
    <xacro:joint_interface joint_name="leg_3_femur_joint"/>
    <xacro:joint_interface joint_name="leg_3_tibia_joint"/>
    <xacro:joint_interface joint_name="leg_4_hip_joint"/>
    <xacro:joint_interface joint_name="leg_4_femur_joint"/>
    <xacro:joint_interface joint_name="leg_4_tibia_joint"/>
    <xacro:joint_interface joint_name="leg_5_hip_joint"/>
    <xacro:joint_interface joint_name="leg_5_femur_joint"/>
    <xacro:joint_interface joint_name="leg_5_tibia_joint"/>
    <xacro:joint_interface joint_name="leg_6_hip_joint"/>
    <xacro:joint_interface joint_name="leg_6_femur_joint"/>
    <xacro:joint_interface joint_name="leg_6_tibia_joint"/>
  </ros2_control>

  <!-- GAZEBO ROS2 CONTROL PLUGIN -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find hexapod_ws)/config/parameters.yaml</parameters>
    </plugin>
  </gazebo>
</robot>