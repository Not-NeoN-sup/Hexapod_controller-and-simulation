<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hexapod">
  
  <xacro:property name="base_radius" value="0.18"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="hip_length" value="0.05"/>
  <xacro:property name="femur_length" value="0.12"/>
  <xacro:property name="tibia_length" value="0.18"/>
  <xacro:property name="leg_radius" value="0.01"/>
  <xacro:property name="joint_lower_limit" value="-1.57"/>
  <xacro:property name="joint_upper_limit" value="1.57"/>
  
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU Sensor -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- LiDAR Sensor -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- LEG MACRO -->
  <xacro:macro name="leg" params="leg_name hx hy angle">
    
    <link name="${leg_name}_hip_link">
      <inertial>
        <origin xyz="${hip_length/2} 0 0" rpy="0 1.5708 0"/>
        <mass value="0.05"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="${hip_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="${hip_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${hip_length}"/></geometry>
      </collision>
    </link>

    <joint name="${leg_name}_hip_joint" type="revolute">
      <origin xyz="${hx} ${hy} ${base_height/2}" rpy="0 0 ${angle}"/>
      <parent link="base_link"/>
      <child link="${leg_name}_hip_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="4"/>
    </joint>

    <link name="${leg_name}_femur_link">
      <inertial>
        <origin xyz="${femur_length/2} 0 0" rpy="0 1.5708 0"/>
        <mass value="0.08"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="${femur_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${femur_length}"/></geometry>
        <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="${femur_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${femur_length}"/></geometry>
      </collision>
    </link>

    <joint name="${leg_name}_femur_joint" type="revolute">
      <origin xyz="${hip_length} 0 0" rpy="0 0 0"/>
      <parent link="${leg_name}_hip_link"/>
      <child link="${leg_name}_femur_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="4"/>
    </joint>

    <link name="${leg_name}_tibia_link">
      <inertial>
        <origin xyz="${tibia_length/2} 0 0" rpy="0 1.5708 0"/>
        <mass value="0.06"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="${tibia_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${tibia_length}"/></geometry>
        <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="${tibia_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="${leg_radius}" length="${tibia_length}"/></geometry>
      </collision>
    </link>

    <joint name="${leg_name}_tibia_joint" type="revolute">
      <origin xyz="${femur_length} 0 0" rpy="0 0 0"/>
      <parent link="${leg_name}_femur_link"/>
      <child link="${leg_name}_tibia_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="10" velocity="4"/>
    </joint>

    <link name="${leg_name}_foot">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.02"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision name="${leg_name}_foot_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.02"/></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="${leg_name}_foot_joint" type="prismatic">
      <origin xyz="${tibia_length} 0 0" rpy="0 0 0"/>
      <parent link="${leg_name}_tibia_link"/>
      <child link="${leg_name}_foot"/>
      <axis xyz="1 0 0"/> <limit lower="-0.05" upper="0.0" effort="100" velocity="10"/>
      
      <dynamics damping="1.0" friction="0" spring_stiffness="1" spring_reference="0.0"/>
    </joint>

  </xacro:macro>

  <!-- CREATE 6 LEGS (60 degrees apart) -->
  <xacro:leg leg_name="leg_1" hx="${base_radius}" hy="0.0" angle="0"/>
  <xacro:leg leg_name="leg_2" hx="${base_radius*0.5}" hy="${base_radius*0.866}" angle="1.0472"/>
  <xacro:leg leg_name="leg_3" hx="${-base_radius*0.5}" hy="${base_radius*0.866}" angle="2.0944"/>
  <xacro:leg leg_name="leg_4" hx="${-base_radius}" hy="0.0" angle="3.14159"/>
  <xacro:leg leg_name="leg_5" hx="${-base_radius*0.5}" hy="${-base_radius*0.866}" angle="-2.0944"/>
  <xacro:leg leg_name="leg_6" hx="${base_radius*0.5}" hy="${-base_radius*0.866}" angle="-1.0472"/>

  <ros2_control name="HexapodSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <xacro:macro name="joint_control" params="leg_name">
      <joint name="${leg_name}_hip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${leg_name}_femur_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${leg_name}_tibia_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      
      <joint name="${leg_name}_foot_joint">
        <state_interface name="position"/> <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:joint_control leg_name="leg_1"/>
    <xacro:joint_control leg_name="leg_2"/>
    <xacro:joint_control leg_name="leg_3"/>
    <xacro:joint_control leg_name="leg_4"/>
    <xacro:joint_control leg_name="leg_5"/>
    <xacro:joint_control leg_name="leg_6"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find hexapod_ws)/config/parameters.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="lidar_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu/> </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
</robot>